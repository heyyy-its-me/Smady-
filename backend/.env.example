# Database Configuration
APP_ENV=development
DB_HOST=your_rds_endpoint.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
PG_DATABASE=postgres
DB_SCHEMA=smady
DB_SSLMODE=prefer
# For production, set DB_SSLMODE=verify-full and optionally DB_SSL_CA to the mounted RDS CA bundle.

# API Configuration
ICP_ENGINE_API_URL=http://your-icp-engine-api-endpoint/api/v1/recommend
PUBLIC_BACKEND_URL=https://your-backend-url.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Google OAuth (register this exact callback URL in the Google Cloud OAuth client)
# The callback is on the frontend origin and is forwarded through the same-origin /api proxy.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
PUBLIC_FRONTEND_URL=http://localhost:3000

# Mailjet v3.1 transactional email (sender email must be verified in Mailjet)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_API_SECRET=your-mailjet-api-secret
MAILJET_FROM_EMAIL=verified-sender@your-domain.com
MAILJET_FROM_NAME=Smady

# N8N Webhook URLs
N8N_LEADS_WEBHOOK_URL=https://your-n8n-instance/webhook/lead-management-V2
N8N_OUTREACH_WEBHOOK_URL=https://your-n8n-instance/webhook/outreach-id
N8N_MEETINGS_WEBHOOK_URL=https://your-n8n-instance/webhook/book-slot
N8N_PROPOSALS_WEBHOOK_URL=https://your-n8n-instance/webhook/proposal-id
N8N_PROPOSALS_APPROVE_URL=https://your-n8n-instance/webhook/proposal-approve
N8N_PROPOSALS_REJECT_WEBHOOK_URL=https://your-n8n-instance/webhook/proposal-reject

# Security
# Generate each secret independently with a CSPRNG (at least 64 characters).
# These placeholders are intentionally invalid; replace them before starting the API.
N8N_CALLBACK_SECRET=replace-with-a-random-secret-of-at-least-64-characters
JWT_SECRET=replace-with-a-different-random-secret-of-at-least-64-characters
# Local HTTP development only; production must use Secure cookies.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
HSTS_ENABLED=false
